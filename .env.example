# ==============================================================================
# Agent-loop 自动化测试与缺陷修复平台环境配置文件
#
# 使用说明：
# 1. 普通测试人员解压后可直接启动；涉及大模型、ONES 或真机动作时需填写对应凭据和设备参数；
# 2. 如需修改配置，可在 Web 界面点击右上角「系统设置」直接可视化修改并即时生效；
# 3. 也可以直接修改本文件或将其复制为 .env 进行手工配置。
# ==============================================================================

# ------------------------------------------------------------------------------
# 【一、大模型智能视觉与代码修复配置 (LLM Provider)】
# 说明：用于 AI 智能探索用例、缺陷智能分析、大模型视觉检查点判定与代码自动修复。
# ------------------------------------------------------------------------------
# 大模型 API 密钥（例如: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx）
OPENAI_API_KEY=

# 用例自主探索专用密钥；留空时回退 OPENAI_API_KEY
OPENAI_API_KEY_EXPLORATION=

# 固化/候选映射执行后的视觉判定专用密钥；留空时回退 OPENAI_API_KEY
OPENAI_API_KEY_FIXED=

# 大模型 API 接口地址（官方地址或公司内部中转网关，末尾带 /v1）
OPENAI_BASE_URL=https://api.openai.com/v1

# 大模型名称（例如: gpt-4o, claude-3-5-sonnet, deepseek-chat 等）
OPENAI_MODEL=gpt-4o

# 用例自主探索专用模型；留空时回退 OPENAI_MODEL
OPENAI_EXPLORATION_MODEL=

# 固化/候选映射执行后的视觉判定专用模型；留空时回退 OPENAI_MODEL
OPENAI_FIXED_MODEL=

# 大模型接口调用超时时间（秒，推荐 120）
OPENAI_REQUEST_TIMEOUT=120

# 可选：企业代理或私有网关的 CA 证书包。留空时使用系统信任链。
OPENAI_CA_BUNDLE=

# 仅在旧网关确实无法协商现代密码套件时显式开启；不会关闭证书验证。
OPENAI_TLS_ALLOW_LEGACY_CIPHERS=0


# ------------------------------------------------------------------------------
# 【二、ONES 缺陷管理平台集成配置 (ONES Integration)】
# 说明：用于从公司 ONES 平台直接按工单编号拉取缺陷标题、描述、步骤与附件。
# ------------------------------------------------------------------------------
# ONES 平台域名地址（拓步公司内网 ONES 服务器，默认直接可用无需修改）
ONES_BASE_URL=https://ones.topstepht.com:8443

# 可选：ONES 私有 CA 证书包。留空时使用系统信任链，不会跳过证书校验。
ONES_CA_BUNDLE=

# ONES 开发者访问令牌（Auth Token）
# 获取方法：登录 ONES -> 点击右上角个人头像 -> 个人设置 -> 开发者访问令牌 -> 点击生成令牌并复制
ONES_AUTH_TOKEN=

# ONES 团队 UUID（Team UUID）
# 获取方法：在浏览器打开 ONES 任意页面，地址栏 URL 中形如 https://ones.../#/team/【这串UUID】/...
ONES_TEAM_UUID=

# ONES 用户账号 ID（User ID）
# 获取方法：在 ONES「个人设置 -> 个人信息」页面查看用户唯一账号 ID
ONES_USER_ID=


# ------------------------------------------------------------------------------
# 【三、6202 / 6204 真机测试与串口硬件通信 (Hardware & Serial)】
# 说明：用于 6202 真机测试、SuperCom 串口命令收发与 MTP 屏幕截图获取。
# ------------------------------------------------------------------------------
# 真机调试串口号；留空时由前端实时发现已打开的 SuperCom 端口。
W30_HARDWARE_PORT=

# 串口波特率（W30 硬件固件默认波特率 1500000）
W30_HARDWARE_BAUDRATE=1500000

# 串口通信通道（默认 supercom，通过内置 SuperCom-AgentBridge 命名管道通信）
W30_HARDWARE_TRANSPORT=supercom

# 真机截图抓取方式（默认 mtp，通过 Windows 便携设备 MTP 通道拉取截图）
W30_HARDWARE_CAPTURE_PROVIDER=mtp

# 真机项目代号（默认 6202_W5230）
W30_HARDWARE_PROJECT=6202_W5230

# （可选）低功耗蓝牙 BLE 截图实验配置。地址留空时实时扫描唯一匹配手表；
# 多台匹配设备会安全失败，此时可临时填写目标地址作为显式覆盖。
W30_HARDWARE_BLE_ADDRESS=
W30_HARDWARE_BLE_SCAN_TIMEOUT=15


# ------------------------------------------------------------------------------
# 【四、模拟器与源码工作区配置 (Simulator & Firmware Source)】
# 说明：用于本地 Windows 模拟器运行、固件源码编译与补丁验证（普通测试人员可保持默认）。
# 所有相对路径均以 Agent-loop 应用根（源码布局中的 system 目录、便携版中的 EXE 目录）为基准，
# 不受启动终端当前目录影响。下面是源码模式下统一多工作区布局的推荐配置。
# ------------------------------------------------------------------------------
# 统一布局根；便携发布包应留空，以保持包内自包含。
AGENT_LOOP_LAYOUT_ROOT=..
AGENT_LOOP_WORKSPACE_BASE=../workspaces/firmware

# 620C 模拟器源码根目录（只在源码修复与模拟器编译时需要）
W30_SOURCE_ROOT=../workspaces/firmware/620C_W6830
W30_AGENT_WORKSPACE_ROOT=../workspaces/firmware/620C_W6830
W30_PROJECT=620C_W6830
SIMULATOR_TOOL_PATH=D:\path\to\simulator-tool
SIMULATOR_BUILD_DIRECTORY=../workspaces/firmware/620C_W6830/core/gui/simulator/out/build/620C_W6830
SIMULATOR_ARTIFACT_PATH=../workspaces/firmware/620C_W6830/core/gui/simulator/bin/main.exe

# 6202 真机源码根目录（只在真机源码级修复验证时需要）
W30_HARDWARE_SOURCE_ROOT=../workspaces/firmware/6202_W5230
W30_HARDWARE_WORKSPACE_ROOT=../workspaces/firmware/6202_W5230

# 6202 真机普通探索/固化用例只读取发布档案，不读取上面两项源码路径。
# 根目录结构为 <profile-root>\6202_W5230\releases\<version>；版本留空使用 latest.json。
W30_HARDWARE_PROJECT=6202_W5230
W30_HARDWARE_PROFILE_ROOT=profiles
W30_HARDWARE_PROFILE_VERSION=

# 6202 模拟器运行配置
W30_6202_SIMULATOR_SOURCE_ROOT=../workspaces/firmware/6202_W5230
W30_6202_SIMULATOR_BUILD_DIRECTORY=../workspaces/firmware/6202_W5230/core/gui/simulator/out/build/6202_W5230
W30_6202_SIMULATOR_ARTIFACT_PATH=../workspaces/firmware/6202_W5230/core/gui/simulator/bin/main.exe

# Web 编排子进程的硬超时（秒）；超时会终止进程树并记录为执行异常，不会判成产品 FAIL。
AGENT_LOOP_CASE_TIMEOUT=1800
AGENT_LOOP_REPAIR_TIMEOUT=3600

# 架构分析扩展（可选）
DESIGNER_ENABLED=0
DESIGNER_MCP_ADAPTER_PATH=


# ------------------------------------------------------------------------------
# 【五、579 O2 真机平台（无桌面工作台）】
# 控制链：PC -> ADB -> APP Bridge -> BLE -> 579 手表
# 观察链：579 手表 -> COM3（严格只读）-> O1 日志 / O2 截图
# ------------------------------------------------------------------------------
# 先启用 579 配置可见性；未完成受控 Canary 前建议保持 false
PLATFORM_579_ENABLED=false

# ADB 与手机 APP Bridge
PLATFORM_579_ADB_PATH=
PLATFORM_579_ADB_SERIAL=
PLATFORM_579_APP_PACKAGE=
PLATFORM_579_BRIDGE_COMPONENT=
PLATFORM_579_BRIDGE_ACTION=
PLATFORM_579_ADB_TIMEOUT=12

# COM3 只读观察；Agent-loop 不提供串口 write/send/flush 接口
PLATFORM_579_COM_PORT=COM3
PLATFORM_579_COM_BAUDRATE=1500000
PLATFORM_579_SCREEN_WIDTH=410
PLATFORM_579_SCREEN_HEIGHT=502
PLATFORM_579_ARTIFACT_ROOT=

# 实机业务动作总门禁。默认 false，网页普通配置不能开启。
PLATFORM_579_DEVICE_ACTIONS_ENABLED=false
