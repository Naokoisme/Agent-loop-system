# Copy this file to .env and fill in machine-local values.
# Never commit .env, credentials, device addresses, COM ports, or private paths.

# LLM provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT=120

# ONES integration (optional)
ONES_BASE_URL=
ONES_AUTH_TOKEN=
ONES_TEAM_UUID=
ONES_USER_ID=

# Designer integration (optional)
DESIGNER_ENABLED=0
DESIGNER_MCP_ADAPTER_PATH=

# 620C Windows Simulator example
W30_SOURCE_ROOT=D:\path\to\firmware-source
W30_AGENT_WORKSPACE_ROOT=D:\path\to\isolated-workspace
W30_PROJECT=620C_W6830
SIMULATOR_TOOL_PATH=D:\path\to\simulator-tool
SIMULATOR_BUILD_DIRECTORY=D:\path\to\simulator-build
SIMULATOR_ARTIFACT_PATH=D:\path\to\simulator.exe

# 6202 real-device example
W30_HARDWARE_SOURCE_ROOT=D:\path\to\firmware-source
W30_HARDWARE_WORKSPACE_ROOT=D:\path\to\isolated-workspace
W30_HARDWARE_PROJECT=6202_W5230
W30_HARDWARE_TRANSPORT=supercom
W30_HARDWARE_PORT=
W30_HARDWARE_BAUDRATE=1500000
W30_HARDWARE_CAPTURE_PROVIDER=mtp

# Optional BLE capture experiment. Leave the address empty until a device is
# explicitly selected on the local machine.
W30_HARDWARE_BLE_ADDRESS=
W30_HARDWARE_BLE_SCAN_TIMEOUT=15

# 6202 Windows Simulator example
W30_6202_SIMULATOR_SOURCE_ROOT=D:\path\to\6202-workspace
W30_6202_SIMULATOR_BUILD_DIRECTORY=D:\path\to\6202-simulator-build
W30_6202_SIMULATOR_ARTIFACT_PATH=D:\path\to\6202-simulator.exe
